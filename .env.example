# KI-Barometer — environment variables (Phase 4+)
#
# Copy to `.env.local` for local development. NEVER commit real values.
# The demo routes (/demo, /dashboard) need none of these; the product
# routes (/app, /login, /admin) need the Supabase block.

# --- Supabase (EU region, Frankfurt) -----------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string (URI, "Session" mode).
# Only needed to run `pnpm db:migrate`; not read by the app itself.
SUPABASE_DB_URL=

# --- App -------------------------------------------------------------------
# Public base URL used in login links (Vercel sets VERCEL_URL automatically;
# set this explicitly for a custom domain).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# dbrains staff who may create organizations (comma-separated).
PLATFORM_ADMIN_EMAILS=
# Random secret (>= 32 chars) for the keyed hash that derives respondent keys
# from memberships. Rotating it orphans all respondent profiles — keep it.
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PSEUDONYM_SECRET=
# Random secret the scheduler must send as `Authorization: Bearer …` to
# /api/cron/*. Vercel Cron sends it automatically when the variable exists.
CRON_SECRET=
# console | supabase — defaults to supabase when Supabase is configured.
MAIL_PROVIDER=
